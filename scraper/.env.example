# Scraper environment. Zkopíruj do scraper/.env (v .gitignore) a vyplň hodnoty.

# Neon connection string, role etl_rw. Pooled (port 5432, host s "-pooler").
DATABASE_URL=postgresql://etl_rw:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/app?sslmode=require

# Identifikátor scraperu. Doplň si do závorky vlastní kontaktní e-mail nebo URL.
USER_AGENT=AkceNaPatek/0.1 (osobni nekomercni projekt; kontakt: <doplnit>)

# Default 0.5 rps = 1 požadavek / 2 s. Nižší hodnota = šetrnější, pomalejší.
RATE_LIMIT_RPS=0.5

# Vercel on-demand revalidace (vyplň po deploy v M3). Nepovinné.
REVALIDATE_URL=https://akce-na-patek.vercel.app/api/revalidate
REVALIDATE_TOKEN=change-me
